  {
   "id": "3.2", "when": {"type": "age", "player": 1, "at_least": 2},
   "do": [{"do": "hint", "text": "Boyar lances strike hard in a charge. To set wood on fire, select units and Alt+right-click an enemy building: they will carry torches to it."}]
  },
  {
   "id": "3.3",
