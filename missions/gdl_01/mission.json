   "when": {"type": "all", "of": [{"type": "fired", "trigger": "3.4"}, {"type": "group_dead", "group": "skir_knights"}, {"type": "not", "of": {"type": "group_exited", "group": "skir_knights"}}]},
   "do": [{"do": "objective", "id": "knights", "state": "done"}]
  },
  {
   "id": "knights_gone", "when": {"type": "group_exited", "group": "skir_knights"},
   "do": [{"do": "objective", "id": "knights", "state": "failed"}]
  },
  {
