   "do": [{"do": "objective", "id": "riders", "state": "failed"}]
  },
  {
   "id": "3.5", "when": {"type": "destroyed", "building": "skir_castle"},
   "do": [
    {"do": "objective", "id": "burn", "state": "done"},
    {"do": "objective", "id": "riders", "state": "done"},
    {
     "do": "dialogue",
     "lines": [
      ["Chronicler", "The castle at Skirsnemune burned, and the knights who sat in it were killed. Both our books and the German ones write of it. But there was still Dubysa, where the vogt himself sat."]
     ]
    },
    {"do": "boats", "on": false},
    {"do": "blockade", "on": true},
    {"do": "objective", "id": "blockade", "text": "Hold the three posts around Dubysa until the garrison leaves"},
    {"do": "hint", "text": "Dubysa need not be stormed. Hold the road up the Dubysa, the river road and the Neman bank with no enemies near them: cut off, the garrison weakens from sickness and hunger."},
    {"do": "ping", "at": [52, 108], "radius": 5},
    {"do": "ping", "at": [74, 134], "radius": 5},
    {"do": "ping", "at": [66, 141], "radius": 5}
   ]
  },
  {
   "id": "4.1", "when": {"type": "blockade_held"},
   "do": [{"do": "hint", "text": "Dubysa is cut off. While all three posts are held, the garrison loses strength. Every two minutes it will sally out against one of them."}]
  },
  {
   "id": "4.1b", "when": {"type": "flag", "flag": "sortie"},
   "do": [{"do": "hint", "text": "A sortie from Dubysa! Beat it back and take the post again: while a post is lost, the blockade does not work."}]
  },
  {
   "id": "4.2", "when": {"type": "garrison_at_most", "permille": 500},
   "do": [
    {
     "do": "dialogue", "id": "coughing",
     "lines": [
      ["hero_gintaut", "They have been coughing for a whole week. Did you do this to them?"],
      ["hero_keeper", "In spring they stood on the bog, they drink river water and eat old grain. Think what you like."],
      ["hero_gintaut", "I am asking what you think."],
      ["hero_keeper", "I think the land does not want them."]
     ]
    }
   ]
  },
  {
   "id": "4.3",
   "when": {
    "type": "all",
    "of": [
     {"type": "fired", "trigger": "3.5"},
     {
      "type": "any",
      "of": [
