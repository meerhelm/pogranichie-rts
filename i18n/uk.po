msgid "«%s» (a hive) stands in the forest; two peasants gather food there."
msgstr "«%s» стоїть у лісі; там збирають мед (їжу) двоє селян."

msgid "«%s» leads to the next age, «%s», for 500 food."
msgstr "«%s» веде до наступної епохи, «%s», за 500 їжі."

msgid "«%s» stands only on a place of power and gives Power."
msgstr "«%s» стоїть лише на місці сили і дає Силу."

msgid "«%s» takes wood, «%s» food, «%s» iron and silver."
msgstr "«%s» приймає дерево, «%s» — їжу, «%s» — залізо і срібло."

msgid "«%s», trained there, casts spells for Power."
msgstr "«%s», навчена там, чарує за Силу."
