msgid "Did we start it?"
msgstr "Гэта мы пачалі?"

msgid "Dismount"
msgstr "Спешыцца"

msgid "Do not let the knight brothers reach the boats"
msgstr "Не дапусціць братоў-рыцараў да чоўнаў"

msgid "Draw"
msgstr "Нічыя"

msgid "Equal money"
msgstr "Роўныя грошы"

