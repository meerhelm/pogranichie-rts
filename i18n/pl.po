# Pogranichie, pl. Keys come from `python3 -m tools.i18n.extract`, which keeps
# the translations here; an empty msgstr falls back to English.
msgid ""
msgstr ""
"Project-Id-Version: Pogranichie\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: pl\n"

msgid "%d %s"
msgstr "%d %s"

msgid "%d Power"
msgstr "%d Mocy"

msgid "%d food per sowing"
msgstr "%d żywności z jednego zasiewu"

msgid "%d s"
msgstr "%d s"

msgid "%d units"
msgstr "Jednostki: %d"

msgid "%d%% of its price is left in heaps; peasants carry it to the stores."
msgstr "%d%% ceny zostaje w stertach; chłopi zanoszą to do magazynów."

msgid "%s Power a second on a place of power"
msgstr "%s Mocy na sekundę w miejscu mocy"

msgid "%s gathered"
msgstr "Zebrano: %s"

msgid "(%d s)"
msgstr "(%d s)"

msgid "(optional) %s"
msgstr "(dodatkowe) %s"

msgid "+%d damage against %s"
msgstr "+%d obrażeń przeciw: %s"

msgid "+%d population"
msgstr "+%d ludności"

msgid "+%d range shooting from the forest"
msgstr "+%d zasięgu, gdy strzela z lasu"

msgid "+%s a second"
msgstr "+%s na sekundę"

msgid "1. You start with «%s», 5 peasants and room for 5 people only."
msgstr "1. Na starcie masz «%s», 5 chłopów i miejsce tylko dla 5 osób."

msgid "2. Send peasants to the forest, then build «%s»: +5 population."
msgstr "2. Wyślij chłopów do lasu, potem zbuduj «%s»: +5 ludności."

msgid "3. Build «%s» by the forest and put a peasant on it."
msgstr "3. Zbuduj «%s» przy lesie i postaw na nim chłopa."

msgid "4. Click «%s» and train more peasants (50 food each)."
msgstr "4. Kliknij «%s» i szkol więcej chłopów (po 50 żywności)."

msgid "5. Build «%s», «%s» or «%s» and train an army."
msgstr "5. Zbuduj «%s», «%s» lub «%s» i szkol wojsko."

msgid "A barrier of felled trees laid in the forest. Nobody passes it; fire burns it away."
msgstr "Zawał ze ściętych drzew w lesie. Nikt przez niego nie przejdzie; ogień go spala."

msgid "A brother priest: consecrates the land and casts the Order's spells."
msgstr "Brat kapłan: uświęca ziemię i rzuca zaklęcia Zakonu."

msgid "A castle, the stronghold of the land: trains the best troops and houses many people. Like a town centre, it keeps your side in the game."
msgstr "Zamek, ostoja ziemi: szkoli najlepsze wojska i mieści wielu ludzi. Tak jak dwór, utrzymuje twoją stronę w grze."

msgid "A chapel of the Order. It gathers Power for spells and consecrates the land: shrines of other sides near it give half the Power."
msgstr "Kaplica Zakonu. Zbiera Moc na zaklęcia i uświęca ziemię: cudze sanktuaria w pobliżu dają o połowę mniej Mocy."

msgid "A church: trains priests and researches the faith's improvements."
msgstr "Kościół: szkoli kapłanów i bada ulepszenia wiary."

msgid "A crossbowman: slow to load, hits hard."
msgstr "Kusznik: długo ładuje, za to bije mocno."

msgid "A fast light horseman with javelins."
msgstr "Szybki lekki jeździec z sulicami."

msgid "A field. A peasant working it brings in food; when it is worked out, it is sown again for its price."
msgstr "Pole. Chłop przy nim zbiera żywność; gdy pole się wyczerpie, zostaje ponownie obsiane za swoją cenę."

msgid "A gate in your wall: your own people pass, enemies have to break it down."
msgstr "Brama w twoim murze: swoi przechodzą, wrogowie muszą ją wyłamać."

msgid "A half-brother in a grey cloak: the Order's medium horse."
msgstr "Półbrat w szarym płaszczu: średnia jazda Zakonu."

msgid "A heavy Lithuanian lancer."
msgstr "Ciężki litewski kopijnik."

msgid "A hive hollowed out in a forest tree. Two peasants take honey from it: food that never runs out."
msgstr "Barć wydrążona w leśnym drzewie. Dwóch chłopów bierze z niej miód: żywność, która nigdy się nie kończy."

msgid "A house feeds more mouths. Train peasants at the yard and build a granary near the food."
msgstr "Chata wyżywi więcej gąb. Szkol chłopów na dworze i postaw spichlerz blisko jadła."

msgid "A knight brother in a white cloak: the Order's heavy horse."
msgstr "Brat rycerz w białym płaszczu: ciężka jazda Zakonu."

msgid "A light horseman from the Prussian lands."
msgstr "Lekki jeździec z ziem pruskich."

msgid "A new age opens new buildings, troops and improvements."
msgstr "Nowa epoka otwiera nowe budynki, wojska i ulepszenia."

msgid "A shrine stands on it"
msgstr "Stoi na nim sanktuarium"

msgid "A silver mine (grey blocks on a hill) gives silver."
msgstr "Kopalnia srebra (szare bloki na wzgórzu) daje srebro."

msgid "A smithy: researches better weapons and armor for your troops."
msgstr "Kuźnia: bada lepszą broń i pancerze dla twoich wojsk."

msgid "A sortie from Dubysa! Beat it back and take the post again: while a post is lost, the blockade does not work."
msgstr "Wycieczka z Dubisy! Odeprzyj ją i zajmij posterunek z powrotem: póki posterunek stracony, blokada nie działa."

msgid "A store at the forest edge: woodcutters carry wood a shorter way. Researches forestry improvements."
msgstr "Skład na skraju lasu: drwale noszą drewno krótszą drogą. Bada ulepszenia leśne."

msgid "A store by bog ore or a silver mine: miners carry a shorter way. Researches mining improvements."
msgstr "Skład przy rudzie darniowej lub kopalni srebra: górnicy noszą krótszą drogą. Bada ulepszenia górnicze."

msgid "A store for food near the fields: peasants carry the harvest a shorter way. Researches farming improvements."
msgstr "Skład żywności przy polach: chłopi noszą plony krótszą drogą. Bada ulepszenia rolnictwa."

msgid "A sturdy archer of the castle garrisons."
msgstr "Wytrzymały łucznik zamkowych załóg."

msgid "A tower that shoots arrows at enemies in range. Palisades and walls join onto it."
msgstr "Wieża, która strzela z łuku do wrogów w zasięgu. Dołączają do niej palisady i mury."

msgid "A trading house. Trade is not in this version yet."
msgstr "Dom handlowy. Handlu w tej wersji jeszcze nie ma."

msgid "A wagon of the baggage train."
msgstr "Wóz taborowy."

msgid "A wall of sharpened stakes: drag to lay a line. Holds enemies off until they break through; it burns."
msgstr "Mur z zaostrzonych pali: przeciągnij, by ułożyć linię. Powstrzymuje wrogów, aż się przebiją; płonie."

msgid "A wise woman: heals those around her and casts the Duchy's spells."
msgstr "Znachorka: leczy tych wokół siebie i rzuca zaklęcia Księstwa."

msgid "Abilities"
msgstr "Umiejętności"

msgid "Advance to the next age"
msgstr "Przejście do następnej epoki"

msgid "Advance to: %s"
msgstr "Przejdź do epoki: %s"

msgid "Age"
msgstr "Epoka"

msgid "Ages"
msgstr "Epoki"

msgid "Aggressive"
msgstr "Zaczepna"

msgid "All places of power held for five minutes."
msgstr "Wszystkie miejsca mocy utrzymane przez pięć minut."

msgid "All three Smolensk banners have fallen. The wings are torn apart."
msgstr "Wszystkie trzy chorągwie smoleńskie padły. Skrzydła są rozerwane."

msgid "Always on"
msgstr "Zawsze włączone"

msgid "An alka, a pagan sanctuary. It gathers Power for spells and trains wise women; near it their spells recharge faster."
msgstr "Alka, pogańskie sanktuarium. Zbiera Moc na zaklęcia i szkoli znachorki; przy niej ich zaklęcia odnawiają się szybciej."

msgid "An archer at home in the forest."
msgstr "Łucznik, dla którego las jest domem."

msgid "An oak can be cut down. But the place where it grew is still here. Set stones in a circle, as your grandfather did, and the fire will come back."
msgstr "Dąb można ściąć. Ale miejsce, gdzie rósł, zostało. Ułóż kamienie w krąg, jak twój dziad, a ogień wróci."

msgid "And whose man are you?"
msgstr "A ty czyj jesteś?"

msgid "Archers among the trees are harder to hit. Let the spearmen hold the Order's men while your archers shoot from the forest."
msgstr "Łucznika między drzewami trudniej trafić. Niech włócznicy trzymają ludzi Zakonu, a łucznicy strzelają z lasu."

msgid "Archers: +1 pierce damage and +1 range."
msgstr "Strzelcy: +1 obrażeń przebijających i +1 zasięgu."

msgid "Are you the Gintaut who burned the chapel?"
msgstr "To ty jesteś ten Gintowt, co spalił kaplicę?"

msgid "Armor %d melee / %d pierce"
msgstr "Pancerz %d wręcz / %d przeb."

msgid "Army"
msgstr "Wojsko"

msgid "At most %d at a time"
msgstr "Najwyżej %d naraz"

msgid "At most %d for each castle"
msgstr "Najwyżej %d na każdy zamek"

msgid "Attack any enemy they see and chase it."
msgstr "Atakować każdego widzianego wroga i ścigać go."

msgid "B next, F turn, Shift keep placing, Esc or right click cancel"
msgstr "B dalej, F obrót, Shift stawiaj dalej, Esc lub PPM anuluj"

msgid "Back"
msgstr "Wstecz"

msgid "Being taken apart"
msgstr "Trwa rozbiórka"

msgid "Being taken apart: %d%%"
msgstr "Rozbiórka: %d%%"

msgid "Bog ore"
msgstr "Ruda darniowa"

msgid "Bog ore (brown blocks in the bog) gives iron."
msgstr "Ruda darniowa (brązowe bloki na bagnie) daje żelazo."

msgid "Boyar lances strike hard in a charge. To set wood on fire, select units and Alt+right-click an enemy building: they will carry torches to it."
msgstr "Kopie bojarskie biją mocno w szarży. By podpalić drewno, zaznacz oddział i kliknij Alt+PPM wrogi budynek: poniosą tam pochodnie."

msgid "Bread first. Then the Germans."
msgstr "Najpierw chleb. Potem Niemcy."

msgid "Breaks other sides' spells; a creature loses 150 HP and falls back."
msgstr "Zdejmuje cudze czary; stwór traci 150 PŻ i się cofa."

msgid "Brickworks: while one stands, your towers, walls and castles cost less."
msgstr "Cegielnia: dopóki stoi, twoje wieże, mury i zamki są tańsze."

msgid "Brother priests: +50% HP; Exorcism reaches 2 cells farther."
msgstr "Bracia kapłani: +50% PŻ; Egzorcyzm sięga o 2 pola dalej."

msgid "Build «%s» on a place of power: it gives Power for spells."
msgstr "Zbuduj «%s» na miejscu mocy: daje Moc na czary."

msgid "Build «%s», «%s» or «%s» and train an army. The Order will come."
msgstr "Zbuduj «%s», «%s» lub «%s» i szkol wojsko. Zakon nadejdzie."

msgid "Building and training"
msgstr "Budowa i szkolenie"

msgid "Buildings built"
msgstr "Zbudowane budynki"

msgid "Buildings lost"
msgstr "Utracone budynki"

msgid "Builds and repairs, but gathers nothing."
msgstr "Buduje i naprawia, ale niczego nie zbiera."

msgid "Builds wagons and siege engines."
msgstr "Buduje wozy i machiny oblężnicze."

msgid "Burn Skirsnemune without losing any of Rumbaudas's riders"
msgstr "Spal Skirsnemunę, nie tracąc żadnego jeźdźca Rumbaudasa"

msgid "Burn the castle of Skirsnemune"
msgstr "Spal zamek Skirsnemunę"

msgid "By evening there was no Order left on the field. The Master lay among his own, and with him many of the elder brothers. Their banners the king later had hung in Kraków."
msgstr "Do wieczora nie zostało na polu nic z Zakonu. Mistrz leżał pośród swoich, a z nim wielu starszych braci. Ich chorągwie król kazał potem zawiesić w Krakowie."

msgid "Campaign: %s"
msgstr "Kampania: %s"

msgid "Can be put into your own palisade or wall"
msgstr "Można wstawić we własną palisadę lub mur"

msgid "Can dismount to fight on foot (V)"
msgstr "Może zsiąść z konia i walczyć pieszo (V)"

msgid "Cancel %s"
msgstr "Anuluj: %s"

msgid "Cannot be built on this ground"
msgstr "Nie można budować na tym gruncie"

msgid "Carcass"
msgstr "Tusza"

msgid "Carries %d %s"
msgstr "Niesie: %d %s"

msgid "Charge: ×%s damage after a run-up of %d cells"
msgstr "Szarża: obrażenia ×%s po rozpędzie na %d pola"

msgid "Cheap foot militia with boar spears, good against horsemen."
msgstr "Tanie pospolite ruszenie z rohatynami, dobre przeciw jeźdźcom."

msgid "Cheaper towers, walls and castles"
msgstr "Tańsze wieże, mury i zamki"

msgid "Chronicler"
msgstr "Kronikarz"

msgid "Click your building to train units; Z X C V B N M press its buttons."
msgstr "Kliknij swój budynek, by szkolić jednostki; Z X C V B N M to jego przyciski."

msgid "Click «%s» and train more peasants: the more workers, the faster you grow."
msgstr "Kliknij «%s» i szkol więcej chłopów: im więcej rąk, tym szybszy rozwój."

msgid "Close (F1)"
msgstr "Zamknij (F1)"

msgid "Collector"
msgstr "Poborca"

msgid "Column"
msgstr "Kolumna"

msgid "Conditions not met"
msgstr "Warunki niespełnione"

msgid "Cooldown %d s"
msgstr "Odnowienie %d s"

msgid "Could not save the game"
msgstr "Nie udało się zapisać gry"

msgid "Ctrl+1…9 makes a group, 1…9 selects it."
msgstr "Ctrl+1…9 tworzy grupę, 1…9 ją zaznacza."

msgid "Ctrl+right click: attack-move. Alt+right click: set a building on fire."
msgstr "Ctrl+prawy klik: marsz z atakiem. Alt+prawy klik: podpal budynek."

msgid "Ctrl+right-click moves in attack. Blows to the flank and rear break the enemy's spirit."
msgstr "Ctrl + prawy przycisk: marsz z atakiem. Ciosy w bok i w tył łamią ducha wroga."

msgid "Damage %d (%s)"
msgstr "Obrażenia %d (%s)"

msgid "Defeat"
msgstr "Klęska"

msgid "Defensive"
msgstr "Obronna"

msgid "Destroy the enemy's capital («%s») and castles to win."
msgstr "Aby wygrać, zniszcz stolicę wroga («%s») i zamki."

msgid "Did we start it?"
msgstr "To my zaczęliśmy?"

msgid "Dismount"
msgstr "Zsiądź z koni"

msgid "Do not let all three Smolensk banners fall"
msgstr "Nie pozwól paść wszystkim trzem chorągwiom smoleńskim"

msgid "Do not let the knight brothers reach the boats"
msgstr "Nie dopuść braci rycerzy do łodzi"

msgid "Does not burn"
msgstr "Nie płonie"

msgid "Does not chase fleeing enemies"
msgstr "Nie ściga uciekających wrogów"

msgid "Double click selects all units of that type on screen."
msgstr "Podwójny klik zaznacza wszystkie jednostki tego typu na ekranie."

msgid "Draw"
msgstr "Remis"

msgid "Dubysa garrison: %d%%"
msgstr "Załoga Dubisy: %d%%"

msgid "Dubysa is cut off. While all three posts are held, the garrison loses strength. Every two minutes it will sally out against one of them."
msgstr "Dubisa jest odcięta. Póki trzymasz wszystkie trzy posterunki, załoga słabnie. Co dwie minuty wyjdzie na wycieczkę przeciw jednemu z nich."

msgid "Dubysa need not be stormed. Hold the road up the Dubysa, the river road and the Neman bank with no enemies near them: cut off, the garrison weakens from sickness and hunger."
msgstr "Dubisy nie trzeba szturmować. Trzymaj drogę w górę Dubisy, drogę nadrzeczną i brzeg Niemna, by nie było przy nich wroga: odcięta załoga słabnie od chorób i głodu."

msgid "Each field holds more food: +50%."
msgstr "Każde pole daje więcej żywności: +50%."

msgid "Equal money"
msgstr "Równe zasoby"

msgid "Esc or right click cancel"
msgstr "Esc lub PPM anuluj"

msgid "F1: how to play."
msgstr "F1: jak grać."

msgid "Fall back to the forest without losing Gintaut's banner"
msgstr "Wycofaj się do lasu, nie tracąc chorągwi Gintowta"

msgid "Fields give food faster: +15%."
msgstr "Pola dają żywność szybciej: +15%."

msgid "Fight enemies who come near, then come back."
msgstr "Walczyć z wrogami, którzy podejdą, potem wracać."

msgid "Fight!"
msgstr "Do boju!"

msgid "First steps"
msgstr "Pierwsze kroki"

msgid "Flee from the enemy at full speed, then turn on the chasers."
msgstr "Uciekać przed wrogiem pełnym pędem, a potem uderzyć na pogoń."

msgid "Fleeing!"
msgstr "Ucieka!"

msgid "Food"
msgstr "Żywność"

msgid "Food comes faster: honey from hives +40%, hunting and fields +25%."
msgstr "Żywność płynie szybciej: miód z barci +40%, łowy i pola +25%."

msgid "Food left %d of %d"
msgstr "Zostało żywności: %d z %d"

msgid "Food: build «%s» right by the forest, then right-click it with a peasant."
msgstr "Żywność: zbuduj «%s» tuż przy lesie, potem kliknij je prawym przyciskiem chłopem."

msgid "Food: never runs out"
msgstr "Żywność: nigdy się nie kończy"

msgid "Food: peasants work a farm by the forest or a bort (hive) in it."
msgstr "Żywność: chłopi pracują na polu przy lesie lub przy barci w lesie."

msgid "Foot soldiers and horsemen: +1 melee damage."
msgstr "Piechota i jazda: +1 obrażeń wręcz."

msgid "Foot soldiers: +1 melee and +1 pierce armor."
msgstr "Piechota: +1 pancerza wręcz i +1 przeciw przebiciu."

msgid "Foot spearman of the Order, good against horsemen."
msgstr "Pieszy włócznik Zakonu, dobry przeciw jeźdźcom."

msgid "Forest"
msgstr "Las"

msgid "Forest gives wood."
msgstr "Las daje drewno."

msgid "Form a wedge with its point to the front, for the charge."
msgstr "Ustawić się klinem ostrzem do przodu, do szarży."

msgid "Formation: %s (%s)"
msgstr "Szyk: %s (%s)"

msgid "Forward, at the marshal!"
msgstr "Naprzód, na marszałka!"

msgid "From the darkness you live in. Half of it. And all the rye."
msgstr "Od ciemnoty, w której żyjecie. Od połowy. I od całego żyta."

msgid "From whom?"
msgstr "Przed kim?"

msgid "Fullscreen"
msgstr "Pełny ekran"

msgid "GDL 1. Samogitian Fire"
msgstr "WKL 1. Żmudzki ogień"

msgid "GDL 2. Grunwald"
msgstr "WKL 2. Grunwald"

msgid "Game"
msgstr "Gra"

msgid "Game saved"
msgstr "Gra zapisana"

msgid "Game time: %s"
msgstr "Czas gry: %s"

msgid "Gather 300 food so the village lives through the summer"
msgstr "Zbierz 300 żywności, by wieś przetrwała lato"

msgid "Gathers food, wood, iron and silver, builds and repairs."
msgstr "Zbiera żywność, drewno, żelazo i srebro, buduje i naprawia."

msgid "Gathers resources and builds."
msgstr "Zbiera surowce i buduje."

msgid "Get off the horse and fight on foot: more armor, the speed of foot soldiers."
msgstr "Zsiąść z konia i walczyć pieszo: więcej pancerza, szybkość piechoty."

msgid "Gintaut is wounded and carried off the field. The khorugv has lost its leader."
msgstr "Gintowt jest ranny i zniesiony z pola. Chorągiew straciła wodza."

msgid "Gintaut is wounded. The uprising has lost its leader."
msgstr "Gintowt ranny. Powstanie straciło wodza."

msgid "Gintaut's banner has fallen and nobody raised it. The khorugv is running."
msgstr "Chorągiew Gintowta padła i nikt jej nie podniósł. Oddział ucieka."

msgid "Gintaut's khorugv has been cut to pieces."
msgstr "Chorągiew Gintowta została rozbita w pień."

msgid "Gives"
msgstr "Daje"

msgid "Gives %d food when hunted"
msgstr "Daje %d żywności po upolowaniu"

msgid "Gives back: %s"
msgstr "Zwróci: %s"

msgid "Goal"
msgstr "Cel"

msgid "Got it"
msgstr "Rozumiem"

msgid "Grand Duchy of Lithuania against the Teutonic Order"
msgstr "Wielkie Księstwo Litewskie przeciw Zakonowi Krzyżackiemu"

msgid "Green means it can stand there; the line at the top says why red cannot."
msgstr "Zielone — można postawić; wiersz u góry mówi, czemu czerwone nie."

msgid "HP %d"
msgstr "PŻ %d"

msgid "HP %d · armor %d melee / %d pierce"
msgstr "PŻ %d · pancerz %d wręcz / %d przeb."

msgid "HP %d/%d"
msgstr "PŻ %d/%d"

msgid "Heals %d HP a second to her people within %d cells"
msgstr "Leczy swoich o %d PŻ na sekundę w promieniu %d pól"

msgid "Heavy horse: +10% HP."
msgstr "Ciężka jazda: +10% PŻ."

msgid "Held by: %s"
msgstr "Trzyma: %s"

msgid "Hidden in the forest"
msgstr "Ukryty w lesie"

msgid "Hide hints"
msgstr "Ukryj wskazówki"

msgid "Hint %d of %d"
msgstr "Wskazówka %d z %d"

msgid "Hints in skirmish"
msgstr "Wskazówki w potyczce"

msgid "Hold on, Prince Semyon. We will come back."
msgstr "Wytrzymaj, kniaziu Siemionie. Wrócimy."

msgid "Hold the pier with no enemies near, and the boats with reinforcements will stop coming."
msgstr "Utrzymaj przystań bez wroga w pobliżu, a łodzie z posiłkami przestaną przypływać."

msgid "Hold the three posts around Dubysa until the garrison leaves"
msgstr "Trzymaj trzy posterunki wokół Dubisy, aż załoga odejdzie"

msgid "Hold this spot: fight only what comes within reach."
msgstr "Trzymać miejsce: walczyć tylko z tym, co podejdzie w zasięg."

msgid "Homes for your people. Every unit takes room: when the population is full, nothing more can be trained until you build houses."
msgstr "Domy dla twoich ludzi. Każdy zajmuje miejsce: gdy ludność jest pełna, nikogo więcej nie wyszkolisz, póki nie zbudujesz domów."

msgid "Horsemen: +1 melee and +1 pierce armor."
msgstr "Jazda: +1 pancerza wręcz i +1 przeciw przebiciu."

msgid "Houses %d"
msgstr "Chaty %d"

msgid "Hover a button to see its price and why it is not available."
msgstr "Najedź na przycisk, by zobaczyć cenę i czemu jest niedostępny."

msgid "How to play"
msgstr "Jak grać"

msgid "How to play (F1)"
msgstr "Jak grać (F1)"

msgid "I am asking what you think."
msgstr "Pytam, co ty myślisz."

msgid "I think the land does not want them."
msgstr "Myślę, że ziemia ich nie chce."

msgid "I was at Orsha and heard the guns roar. What I write below I heard from my grandfather, and he from his father. What is true here and what is a tale, judge for yourselves."
msgstr "Byłem pod Orszą i słyszałem ryk dział. Co niżej piszę, słyszałem od dziada, a on od swego ojca. Co tu prawda, a co bajka, osądźcie sami."

msgid "In August Master Ulrich declared war on King Jogaila and marched on Dobrzyń. In autumn they made a truce until Midsummer Day. All winter both sides forged spears. And our great-grandfather rode beyond the Neman for the first time in his life."
msgstr "W sierpniu mistrz Ulrich wypowiedział wojnę królowi Jagielle i ruszył na Dobrzyń. Jesienią zawarli rozejm do świętego Jana. Całą zimę obie strony kuły włócznie. A nasz pradziad pierwszy raz w życiu pojechał za Niemen."

msgid "In spring they stood on the bog, they drink river water and eat old grain. Think what you like."
msgstr "Wiosną stali na bagnie, piją wodę z rzeki i jedzą stare ziarno. A ty myśl, co chcesz."

msgid "In the year of our Lord fourteen hundred and ten, on the fifteenth of July, our great-grandfather Gintaut stood in the right wing, under the hand of Vytautas. They stood a long time, in the sun, in iron."
msgstr "Roku Pańskiego tysiąc czterysta dziesiątego, piętnastego lipca, nasz pradziad Gintowt stał na prawym skrzydle, pod ręką Witolda. Stali długo, w słońcu, w żelazie."

msgid "In work: %s, %d%%"
msgstr "W toku: %s, %d%%"

msgid "Intercept the Order's grain convoy on the river road"
msgstr "Przechwyć zakonny tabor ze zbożem na nadrzecznej drodze"

msgid "Iron"
msgstr "Żelazo"

msgid "Iron is mined faster: +20%."
msgstr "Żelazo wydobywa się szybciej: +20%."

msgid "Iron: right-click bog ore (brown blocks in the bog) with peasants."
msgstr "Żelazo: kliknij chłopami prawym przyciskiem rudę darniową (brązowe bloki na bagnie)."

msgid "Is Samogitia ours now, prince?"
msgstr "Czy Żmudź jest teraz nasza, kniaziu?"

msgid "It needs two other first-age buildings and opens new units."
msgstr "Wymaga dwóch innych budynków pierwszej epoki i otwiera nowe jednostki."

msgid "It rained in the night. Their powder is as wet as their prayers. Hold!"
msgstr "W nocy padało. Proch mają mokry jak swoje modlitwy. Stać!"

msgid "It will be ours. By peace, not by the sword. With the sword we have done all we could."
msgstr "Będzie nasza. Pokojem, nie mieczem. Mieczem zrobiliśmy wszystko, co mogliśmy."

msgid "Javelin: %d damage at %d cells, every %d s"
msgstr "Sulica: %d obrażeń na %d pola, co %d s"

msgid "Keep at least two Smolensk banners"
msgstr "Zachowaj co najmniej dwie chorągwie smoleńskie"

msgid "Keep watching"
msgstr "Oglądaj dalej"

msgid "Keep your units on the place of power with no enemies near to take it. Then peasants can lay an alka on it."
msgstr "Trzymaj ludzi na miejscu mocy bez wroga w pobliżu, by je zająć. Wtedy chłopi mogą ułożyć tam alkę."

msgid "Language"
msgstr "Język"

msgid "Large"
msgstr "Duży"

msgid "Lead forest archers past the Order's watch to the spring"
msgstr "Przeprowadź leśnych łuczników obok straży Zakonu do źródła"

msgid "Left (you)"
msgstr "Lewa (ty)"

msgid "Left click on anything else (enemy, deposit, forest) shows it below."
msgstr "Lewy przycisk na czymkolwiek innym (wróg, złoże, las) pokaże to na dole."

msgid "Left click or drag a box to select."
msgstr "Lewy klik lub ramka — zaznacz."

msgid "Left click selects; drag a box to select several."
msgstr "Lewy klik zaznacza; ramka zaznacza kilka."

msgid "Line"
msgstr "Linia"

msgid "Lithuanian retreat"
msgstr "Ucieczka litewska"

msgid "Lithuanian retreat: flees, then turns on the chasers (T)"
msgstr "Ucieczka litewska: ucieka, potem uderza na pogoń (T)"

msgid "Lithuanian troops can feign a retreat (T) and turn around (G)."
msgstr "Wojska litewskie mogą pozorować ucieczkę (T) i zawracać (G)."

msgid "Load game"
msgstr "Wczytaj grę"

msgid "Lord Gintaut, the Germans are in our grove. They are building a house for their god, and our oaks are going for logs."
msgstr "Panie Gintowcie, Niemcy w naszym gaju. Stawiają dom swemu bogu, a nasze dęby idą na bale."

msgid "Main menu"
msgstr "Menu główne"

msgid "Menu (F10)"
msgstr "Menu (F10)"

msgid "Messenger"
msgstr "Posłaniec"

msgid "Mist over the bog: your people and buildings in it are hidden from the enemy farther than 2 cells."
msgstr "Mgła nad bagnem: twoich ludzi i budynków w niej wróg nie widzi dalej niż na 2 pola."

msgid "Morale %d/%d"
msgstr "Morale %d/%d"

msgid "Morale: never flees"
msgstr "Morale: nigdy nie ucieka"

msgid "Mother of God, Virgin, by God glorified Mary..."
msgstr "Bogurodzica dziewica, Bogiem sławiena Maryja..."

msgid "Move the camera with the arrow keys or the screen edge. Drag to select units."
msgstr "Przesuwaj kamerę strzałkami lub krawędzią ekranu. Przeciągnij, by zaznaczyć jednostki."

msgid "Must stand in the forest"
msgstr "Musi stać w lesie"

msgid "Needs %d finished buildings of the age before."
msgstr "Potrzeba %d gotowych budynków poprzedniej epoki."

msgid "Needs a later age"
msgstr "Wymaga późniejszej epoki"

msgid "Needs forest nearby"
msgstr "Wymaga lasu w pobliżu"

msgid "Never flees"
msgstr "Nigdy nie ucieka"

msgid "New buildings"
msgstr "Nowe budynki"

msgid "Next"
msgstr "Dalej"

msgid "No saved games"
msgstr "Brak zapisanych gier"

msgid "Nobody holds it"
msgstr "Niczyje"

msgid "Normal"
msgstr "Zwykły"

msgid "Not available"
msgstr "Niedostępne"

msgid "Not available yet in this mission"
msgstr "Jeszcze niedostępne w tej misji"

msgid "Not enough Power"
msgstr "Za mało Mocy"

msgid "Not enough resources"
msgstr "Za mało zasobów"

msgid "Not for this faction"
msgstr "Nie dla tej frakcji"

msgid "Not ready yet"
msgstr "Jeszcze niegotowe"

msgid "Nothing selected"
msgstr "Nic nie zaznaczono"

msgid "Nothing to train here yet in this version"
msgstr "W tej wersji nikogo tu jeszcze nie szkolisz"

msgid "Now listen. The land gives strength to whoever holds it. The Germans have their own strength, from books and the bones of saints. We have ours: from groves, from water, from the stones where the gods stood. Send me girls who know herbs. I will teach them to call the mist."
msgstr "Teraz słuchaj. Ziemia daje siłę temu, kto ją trzyma. Niemcy mają swoją siłę, z ksiąg i z kości świętych. My mamy swoją: z gajów, z wody, z kamieni, gdzie stali bogowie. Przyślij mi dziewki, co znają zioła. Nauczę je wołać mgłę."

msgid "Now they will not come here, but to the king. This is no longer a revolt, Gintaut. This is a great war."
msgstr "Teraz pójdą nie tu, lecz na króla. To już nie bunt, Gintowcie. To wielka wojna."

msgid "Objectives"
msgstr "Cele"

msgid "Off the map"
msgstr "Poza mapą"

msgid "Only in the forest"
msgstr "Tylko w lesie"

msgid "Only next to the forest"
msgstr "Tylko obok lasu"

msgid "Only on a place of power"
msgstr "Tylko na miejscu mocy"

msgid "Opponent: easy"
msgstr "Przeciwnik: łatwy"

msgid "Opponent: normal"
msgstr "Przeciwnik: zwykły"

msgid "Or hold every place of power on the map for 5 minutes."
msgstr "Albo utrzymaj wszystkie miejsca mocy na mapie przez 5 minut."

msgid "Our great-grandfather Gintaut was neither prince nor lord. A boyar with three farmsteads, one horse and one grove where his grandfathers still prayed. And in the spring of fourteen hundred and nine he decided he would bear it no longer."
msgstr "Nasz pradziad Gintowt nie był ani księciem, ani panem. Bojar o trzech zagrodach, jednym koniu i jednym gaju, gdzie modlili się jeszcze jego dziadowie. A wiosną roku tysiąc czterysta dziewiątego postanowił, że dłużej tego nie zniesie."

msgid "P pauses, Esc or F10 opens the menu, F1 shows this page."
msgstr "P — pauza, Esc lub F10 — menu, F1 — ta strona."

msgid "Passive"
msgstr "Bierna"

msgid "Paused"
msgstr "Pauza"

msgid "Paused (P)"
msgstr "Pauza (P)"

msgid "Peasants bring here every resource"
msgstr "Chłopi przynoszą tu wszystkie surowce"

msgid "Peasants bring here: %s"
msgstr "Chłopi przynoszą tu: %s"

msgid "Peasants carry everything to «%s» or to a nearer store."
msgstr "Chłopi niosą wszystko do «%s» albo do bliższego składu."

msgid "Peasants fell it for wood (right click)."
msgstr "Chłopi wycinają go na drewno (prawy przycisk)."

msgid "Peasants gather it (right click)."
msgstr "Zbierają to chłopi (prawy przycisk)."

msgid "Peasants take it apart and carry %d%% of its price to storage."
msgstr "Chłopi rozbiorą go i zaniosą %d%% ceny do magazynu."

msgid "Pick one and left-click the ground; F turns it, Shift lays several."
msgstr "Wybierz i kliknij lewym ziemię; F obraca, Shift stawia kilka."

msgid "Place of power"
msgstr "Miejsce mocy"

msgid "Player %d, %s"
msgstr "Gracz %d, %s"

msgid "Pogranichie"
msgstr "Pogranicze"

msgid "Polish warriors"
msgstr "Polscy wojowie"

msgid "Population %d/%d"
msgstr "Ludność %d/%d"

msgid "Population is full. With a peasant selected, build «%s» (button bottom right)."
msgstr "Brak miejsca dla ludzi. Zaznacz chłopa i zbuduj «%s» (przycisk w prawym dolnym rogu)."

msgid "Population limit reached"
msgstr "Osiągnięto limit ludności"

msgid "Posts held: %d of %d"
msgstr "Posterunki: %d z %d"

msgid "Power"
msgstr "Moc"

msgid "Power and spells"
msgstr "Moc i czary"

msgid "Power gained"
msgstr "Zdobyta Moc"

msgid "Power x%.1f"
msgstr "Moc ×%.1f"

msgid "Power: build a shrine on a place of power; spells spend it."
msgstr "Moc: zbuduj sanktuarium na miejscu mocy; czary ją zużywają."

msgid "Q E R: line, column, wedge."
msgstr "Q E R: linia, kolumna, klin."

msgid "Quit"
msgstr "Wyjdź"

msgid "Researched once, works for all your people."
msgstr "Badane raz, działa na wszystkich twoich ludzi."

msgid "Researches: %s"
msgstr "Bada: %s"

msgid "Reset"
msgstr "Przywróć"

msgid "Resources"
msgstr "Surowce"

msgid "Resume"
msgstr "Wznów"

msgid "Right"
msgstr "Prawa"

msgid "Right click gives orders. F1: how to play."
msgstr "Prawy klik wydaje rozkazy. F1: jak grać."

msgid "Right click orders: walk, attack the enemy, or work on what you click."
msgstr "Prawy klik to rozkaz: idź, atakuj wroga albo pracuj przy tym, co klikniesz."

msgid "Right click with a building selected sets where its units gather."
msgstr "Prawy klik przy zaznaczonym budynku wyznacza miejsce zbiórki jego jednostek."

msgid "Right click: rally point"
msgstr "PPM: punkt zbiórki"

msgid "Right-click the forest with peasants selected: they cut wood and carry it home."
msgstr "Zaznacz chłopów i kliknij las prawym przyciskiem: zetną drewno i zaniosą do domu."

msgid "Salvage"
msgstr "Rozbiórka"

msgid "Samogitian warrior"
msgstr "Wojownik żmudzki"

msgid "Save game"
msgstr "Zapisz grę"

msgid "Scroll at the screen edge"
msgstr "Przewijanie przy krawędzi ekranu"

msgid "Select and order"
msgstr "Zaznaczanie i rozkazy"

msgid "Select peasants and right-click game to hunt. Fields by the forest and hives in it give food too."
msgstr "Zaznacz chłopów i kliknij PPM zwierzynę, by polować. Pola przy lesie i barcie w lesie też dają żywność."

msgid "Select peasants and right-click what they should gather."
msgstr "Zaznacz chłopów i prawym przyciskiem wskaż, co mają zbierać."

msgid "Select the light horse and press «Lithuanian retreat»: they ride for the forest in the south-east without losing heart, and right after can turn on their pursuers. Lead the rest there too."
msgstr "Zaznacz lekką jazdę i naciśnij «Ucieczka litewska»: pocwałuje do lasu na południowym wschodzie, nie tracąc ducha, a zaraz potem może zawrócić na pościg. Resztę też prowadź tam."

msgid "Select your peasants: hold the left mouse button and drag a box around them."
msgstr "Zaznacz chłopów: przytrzymaj lewy przycisk myszy i obrysuj ich ramką."

msgid "Settings"
msgstr "Ustawienia"

msgid "Shoots: %d damage (%s), range %d"
msgstr "Strzela: %d obrażeń (%s), zasięg %d"

msgid "Side %d: %d units, %d HP, %d fleeing"
msgstr "Strona %d: jednostki %d, PŻ %d, uciekający %d"

msgid "Silver"
msgstr "Srebro"

msgid "Silver is mined faster: +20%."
msgstr "Srebro wydobywa się szybciej: +20%."

msgid "Silver mine"
msgstr "Kopalnia srebra"

msgid "Silver: right-click a silver mine (grey blocks on a hill) with peasants."
msgstr "Srebro: kliknij chłopami prawym przyciskiem kopalnię srebra (szare bloki na wzgórzu)."

msgid "Size %d×%d cells"
msgstr "Rozmiar %d×%d pól"

msgid "Skirmish"
msgstr "Potyczka"

msgid "Skirsnemune has burned and the vogt has left Dubysa. Samogitia has risen."
msgstr "Skirsnemuna spłonęła, a wójt opuścił Dubisę. Żmudź powstała."

msgid "Skirsnemune. A wooden one."
msgstr "Skirsnemuna. Drewniany."

msgid "Small"
msgstr "Mały"

msgid "Smolensk stands! Tell Vytautas: we will stand as long as we can."
msgstr "Smoleńsk stoi! Powiedzcie Witoldowi: będziemy stać, ile zdołamy."

msgid "Some write that the Lithuanians fled. Others, that they fled on purpose. Grandfather Mikołaj asked his father about it. He laughed and did not answer."
msgstr "Jedni piszą, że Litwini uciekli. Inni, że uciekali umyślnie. Dziad Mikołaj pytał o to ojca. Ten śmiał się i nie odpowiadał."

msgid "Sound the retreat. Hold the banner! Let the Germans run after us, not we from them."
msgstr "Trąbić odwrót. Trzymać chorągiew! Niech Niemcy biegną za nami, a nie my przed nimi."

msgid "Speed %.2f cells/s"
msgstr "Szybkość %.2f pól/s"

msgid "Spells of wise women nearby recharge faster"
msgstr "Zaklęcia znachorek w pobliżu odnawiają się szybciej"

msgid "Stance: %s"
msgstr "Postawa: %s"

msgid "Stand ground"
msgstr "Stój w miejscu"

msgid "Stop"
msgstr "Stój"

msgid "Stop what they are doing and stand."
msgstr "Przerwać to, co robią, i stanąć."

msgid "Strike the flank of the Grand Master's reserve"
msgstr "Uderz w bok odwodu wielkiego mistrza"

msgid "Take all 3 places of power"
msgstr "Zajmij wszystkie 3 miejsca mocy"

msgid "Take all 7 places of power"
msgstr "Zajmij wszystkie 7 miejsc mocy"

msgid "Take apart"
msgstr "Rozebrać"

msgid "Take apart: click your building"
msgstr "Rozbiórka: kliknij swój budynek"

msgid "Take back the sacred grove and lay an alka there"
msgstr "Odbij święty gaj i ułóż tam alkę"

msgid "Take the Order's bombards"
msgstr "Zdobądź bombardy Zakonu"

msgid "Take the wagenburg"
msgstr "Zdobądź tabor"

msgid "Takes %d population"
msgstr "Zajmuje %d miejsca ludności"

msgid "Takes in: %s"
msgstr "Przyjmuje: %s"

msgid "Tatar captain"
msgstr "Setnik tatarski"

msgid "Text size"
msgstr "Rozmiar tekstu"

msgid "That year Samogitia was German. Vytautas gave it to the Order by treaty, and nobody asked us. Last winter there was hunger. King Jogaila sent us grain down the river, but the Germans stopped the boats and said they would feed Samogitia themselves."
msgstr "Tego roku Żmudź była niemiecka. Witold oddał ją Zakonowi traktatem i nikt nas nie pytał. Zeszłej zimy był głód. Król Jagiełło posłał nam zboże rzeką, ale Niemcy zatrzymali łodzie i rzekli, że sami wykarmią Żmudź."

msgid "The Grand Master's reserve broke the Polish centre while the Lithuanians were away."
msgstr "Odwód wielkiego mistrza przełamał polskie centrum, gdy Litwinów nie było."

msgid "The Master is gone! Killed in the melee!"
msgstr "Nie ma mistrza! Zabity w ścisku!"

msgid "The Order is beaten at Grunwald."
msgstr "Zakon rozbity pod Grunwaldem."

msgid "The Order's knechts hold out behind the chained wagons. Break in and cut them down."
msgstr "Knechci Zakonu bronią się za skutymi łańcuchami wozami. Wedrzyj się i wytnij ich."

msgid "The Order's tithe collector is coming up the road."
msgstr "Drogą idzie zakonny poborca dziesięciny."

msgid "The Poles are still singing. So it is time. To horse!"
msgstr "Polacy jeszcze śpiewają. Znaczy, czas. Na koń!"

msgid "The alka gives Power. Every place of power you hold with an alka adds more; near the Order's castles and priests it gives less."
msgstr "Alka daje Moc. Każde twoje miejsce mocy z alką dodaje więcej; przy zamkach i kapłanach Zakonu daje mniej."

msgid "The banner has fallen! Bring a rider to it within 20 seconds."
msgstr "Chorągiew padła! Poślij do niej jeźdźca w ciągu 20 sekund."

msgid "The banner is up again."
msgstr "Chorągiew znów w górze."

msgid "The capital and castles of the losing side are destroyed."
msgstr "Stolica i zamki strony pokonanej są zburzone."

msgid "The castle at Skirsnemune burned, and the knights who sat in it were killed. Both our books and the German ones write of it. But there was still Dubysa, where the vogt himself sat."
msgstr "Zamek w Skirsnemunie spłonął, a rycerze, co w nim siedzieli, zginęli. Piszą o tym i nasze księgi, i niemieckie. Ale była jeszcze Dubisa, gdzie siedział sam wójt."

msgid "The heart of your land: trains peasants, takes in every resource and leads your people into the next age. In a skirmish, a side that loses every town centre and castle is out."
msgstr "Serce twojej ziemi: szkoli chłopów, przyjmuje wszystkie surowce i prowadzi twój lud do następnej epoki. W potyczce strona, która straci wszystkie dwory i zamki, odpada."

msgid "The hints at the top left can be turned off in the settings."
msgstr "Wskazówki w lewym górnym rogu można wyłączyć w ustawieniach."

msgid "The khan is taking his men away. Don't stand there, Lithuanian, or you will stay here for good."
msgstr "Chan zabiera swoich. Nie stój, Litwinie, bo tu zostaniesz na zawsze."

msgid "The knights are coming out! Don't let them reach the boats!"
msgstr "Rycerze wychodzą! Nie puść ich do łodzi!"

msgid "The lance beside Gintaut carries his banner. Units near it keep their spirit. If the bearer falls, bring a rider to the banner within 20 seconds, or the khorugv runs."
msgstr "Kopia obok Gintowta niesie jego chorągiew. Oddziały przy niej trzymają ducha. Jeśli chorąży padnie, poślij do chorągwi jeźdźca w ciągu 20 sekund, inaczej oddział ucieknie."

msgid "The last capital cannot be taken apart"
msgstr "Ostatniej stolicy nie można rozebrać"

msgid "The lone oak on the hill is a place of power. Take it, and the znakharka can lay an alka there for Power."
msgstr "Samotny dąb na wzgórzu to miejsce mocy. Zajmij je, a znachorka założy tam alkę dla Mocy."

msgid "The lord vogt demands grain for the castles. You wanted to be protected, did you not?"
msgstr "Pan wójt żąda zboża dla zamków. Chcieliście przecież obrony, nieprawdaż?"

msgid "The pier is ours. No more boats will come to Skirsnemune."
msgstr "Przystań nasza. Żadna łódź już nie przypłynie do Skirsnemuny."

msgid "The place is taken"
msgstr "Miejsce zajęte"

msgid "The price is for each cell of the line."
msgstr "Cena za każde pole linii."

msgid "The prince's. Prince Vytautas has not sent us yet. But the Germans held back the king's grain, and now the prince says he did not send us far enough."
msgstr "Książęcy. Książę Witold jeszcze nas nie posłał. Ale Niemcy zatrzymali królewskie zboże, a teraz książę mówi, że posłał nas za blisko."

msgid "The pursuers have lost their order. Turn on them now: a turn right after a retreat strikes hard."
msgstr "Pościg stracił szyk. Zawróć na nich teraz: zwrot zaraz po odwrocie uderza mocno."

msgid "The queue is full"
msgstr "Kolejka pełna"

msgid "The village has burned down."
msgstr "Wieś spłonęła."

msgid "The village ran out of food and starved."
msgstr "Wsi zabrakło jadła i wymarła z głodu."

msgid "The wagon fort! Strike the wagon fort before they come to their senses!"
msgstr "Tabor! Uderzyć na tabor, zanim się opamiętają!"

msgid "The znakharka can call Bog Mist: your units in it cannot be seen until they attack."
msgstr "Znachorka umie wezwać Bagienną mgłę: twoich ludzi w niej nie widać, póki nie uderzą."

msgid "Then click your building."
msgstr "Potem kliknij swój budynek."

msgid "Then two heralds came from the Master and brought two swords. On one shield was the black eagle of the King of the Romans, on the other the griffin of Szczecin. They said: here are swords for you, if your own are too few, and choose the field, if you are afraid."
msgstr "Wtedy od mistrza przybyli dwaj heroldowie i przywieźli dwa miecze. Na jednej tarczy był czarny orzeł króla rzymskiego, na drugiej gryf szczeciński. Rzekli: oto wam miecze, jeśli swoich macie za mało, i wybierzcie pole, jeśli się boicie."

msgid "There are fish in the lake and honey in the hives. The Germans cannot search the whole forest."
msgstr "W jeziorze są ryby, w barciach miód. Niemcy nie przeszukają całej puszczy."

msgid "They cut down the old oak."
msgstr "Ścięli stary dąb."

msgid "They have been coughing for a whole week. Did you do this to them?"
msgstr "Kaszlą od tygodnia. To ty im to zrobiłaś?"

msgid "They have long been waiting for it, prince."
msgstr "Dawno na nią czekają, kniaziu."

msgid "They say a thunderstorm passed over the field in that hour, and lightning struck where the Germans stood. They say. I would like to believe it."
msgstr "Mówią, że w tej godzinie nad polem przeszła burza, a piorun bił tam, gdzie stali Niemcy. Mówią. Chciałbym wierzyć."

msgid "They say the mist rose from the bog in broad daylight, and a German patrol passed ten steps from our men and saw no one. Such mists do happen in Samogitia. But grandfather said that one was special."
msgstr "Mówią, że mgła podniosła się z bagna w biały dzień, a niemiecki podjazd przeszedł dziesięć kroków od naszych i nikogo nie zobaczył. Takie mgły na Żmudzi się zdarzają. Ale dziad mówił, że ta była osobliwa."

msgid "They took the bread, now the grove. Take up your spears."
msgstr "Wzięli chleb, teraz gaj. Bierzcie włócznie."

msgid "Thunder without lightning!"
msgstr "Grom bez błyskawicy!"

msgid "Time: %d s"
msgstr "Czas: %d s"

msgid "To win, destroy the enemy's capital, or hold every place of power for 5 minutes."
msgstr "Aby wygrać, zniszcz stolicę wroga albo utrzymaj wszystkie miejsca mocy przez 5 minut."

msgid "Towers, walls and gates see 2 cells farther."
msgstr "Wieże, mury i bramy widzą o 2 pola dalej."

msgid "Trains archers and crossbowmen."
msgstr "Szkoli łuczników i kuszników."

msgid "Trains foot soldiers."
msgstr "Szkoli piechotę."

msgid "Trains horsemen."
msgstr "Szkoli jeźdźców."

msgid "Trains: %s"
msgstr "Szkoli: %s"

msgid "Turn and face the chasers at once."
msgstr "Od razu zawrócić przodem do pogoni."

msgid "Turn around"
msgstr "Obróć"

msgid "Two fresh Lithuanian banners have gathered at the forest. The reserve is going for the Poles: strike it in the flank before it breaks through. The znakharka can call Perkūnas's Wrath on it."
msgstr "Pod lasem zebrały się dwie świeże chorągwie litewskie. Odwód idzie na Polaków: uderz go w bok, zanim się przebije. Znachorka może ściągnąć na niego Gniew Perkuna."

msgid "Under construction: %d%%"
msgstr "W budowie: %d%%"

msgid "Units killed"
msgstr "Zabite jednostki"

msgid "Units lost"
msgstr "Utracone jednostki"

msgid "Units trained"
msgstr "Wyszkolone jednostki"

msgid "Units walk over it"
msgstr "Można po nim chodzić"

msgid "Unseen in the forest until it shoots"
msgstr "W lesie niewidoczny, dopóki nie strzeli"

msgid "Very large"
msgstr "Bardzo duży"

msgid "Victory"
msgstr "Zwycięstwo"

msgid "W A S D, the arrows or the screen edge move the view."
msgstr "W A S D, strzałki lub krawędź ekranu przesuwają widok."

msgid "Walk and stand in a broad line."
msgstr "Iść i stać szerokim szeregiem."

msgid "Walk in a narrow column, for roads and the forest."
msgstr "Iść wąską kolumną, na drogi i do lasu."

msgid "Wavering"
msgstr "Chwieje się"

msgid "We are going on to Malbork now. I need your men in Samogitia. Go home."
msgstr "Idziemy teraz na Malbork. Twoi ludzie są mi potrzebni na Żmudzi. Wracaj do domu."

msgid "We had to wait a long time for peace. But grandfather told how great-grandfather that evening, for the first time in his life, fell asleep without fear."
msgstr "Na pokój trzeba było długo czekać. Ale dziad opowiadał, jak pradziad tego wieczoru pierwszy raz w życiu zasnął bez strachu."

msgid "We have swords enough. Gintaut! Your Samogitians will be the first to hear the trumpet."
msgstr "Mieczy mamy dość. Gintowcie! Twoi Żmudzini pierwsi usłyszą trąbę."

msgid "We lit it. Others stacked the firewood."
msgstr "My podpaliliśmy. Drwa ułożyli inni."

msgid "We never had to storm Dubysa. Vogt Michael set fire to his own castle so that we would not have it, and led his sick men away to Prussia. The Germans wrote of sickness. But in the Samogitian villages they said otherwise."
msgstr "Dubisy nie przyszło nam szturmować. Wójt Michał sam podpalił swój zamek, by nam się nie dostał, i odprowadził chorych ludzi do Prus. Niemcy pisali o zarazie. Ale po żmudzkich wsiach mówiono inaczej."

msgid "Wedge"
msgstr "Klin"

msgid "Where is the nearest German castle?"
msgstr "Gdzie najbliższy niemiecki zamek?"

msgid "Where it stands"
msgstr "Gdzie stoi"

msgid "Wild, nobody's"
msgstr "Dziki, niczyj"

msgid "Wise women heal 2 HP a second instead of 1."
msgstr "Znachorki leczą 2 PŻ na sekundę zamiast 1."

msgid "With peasants selected, the buttons at the bottom right are buildings."
msgstr "Gdy zaznaczeni są chłopi, przyciski w prawym dolnym rogu to budynki."

msgid "Withstand the cannonade and attack the Order's left wing"
msgstr "Wytrzymaj ostrzał i zaatakuj lewe skrzydło Zakonu"

msgid "Wood"
msgstr "Drewno"

msgid "Wood burns well."
msgstr "Drewno dobrze się pali."

msgid "Wood: right-click the forest with peasants."
msgstr "Drewno: kliknij chłopami prawym przyciskiem las."

msgid "Woodcutters work faster: +20%."
msgstr "Drwale pracują szybciej: +20%."

msgid "Y with peasants, then a click on your building: they take it apart."
msgstr "Y z chłopami, potem klik na swój budynek: rozbiorą go."

msgid "You lead Lithuania from the north-west; the Order is in the south-east."
msgstr "Prowadzisz Litwę z północnego zachodu; Zakon jest na południowym wschodzie."

msgid "You took your time, son of Gintaut. For three days I kept the fire in a pot, the way our old women carry it from house to house."
msgstr "Długo szedłeś, synu Gintowta. Trzy dni trzymałam ogień w garnku, jak nasze baby noszą go od chaty do chaty."

msgid "Your men near the relic do not flee while their morale is above 10; enemies nearby lose 10 morale."
msgstr "Twoi ludzie przy relikwii nie uciekają, póki morale jest powyżej 10; wrogowie w pobliżu tracą 10 morale."

msgid "Your people are not ready to fight yet. Gather your stores again."
msgstr "Twoi ludzie nie są jeszcze gotowi do boju. Zbierz znów zapasy."

msgid "Z X C: aggressive, defensive, stand ground. H: stop."
msgstr "Z X C: zaczepna, obronna, stój w miejscu. H: stój."

msgid "Zasekas are felled twice as fast and have +50% HP."
msgstr "Zasieki układa się dwa razy szybciej i mają +50% PŻ."

